# The Aiven Database Details
DB_HOST=your-aiven-host-address
DB_PORT=your-aiven-port
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=your-db-name

# Authentication (CRITICAL for login to work on Vercel)
JWT_SECRET=put-a-long-random-string-here
JWT_EXPIRES_IN=7d

# Cross-Origin (CRITICAL for Vercel)
# Change this to your actual Vercel domain once you deploy (e.g., https://jiddat.vercel.app)
CLIENT_ORIGIN=https://your-project-name.vercel.app 
